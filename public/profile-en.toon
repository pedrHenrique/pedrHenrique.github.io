meta:
  profile_owner: Pedro Henrique Leonardi Silva
  version: 2.1.2
  last_updated: 2026-10-01
  language: en
  purpose[4]: Complete professional background reference,Job opportunity matching,Basis for resume adaptation and customization,AI-assisted career analysis
  secondary_sources:
    linkedin: "https://www.linkedin.com/in/pedrhenriquels/"
    github: "https://github.com/pedrHenrique"
profile:
  title: Test Automation Engineer
  primary_domain: Software Quality Engineering and Test Automation
  contact:
    email: pedrleonardi@gmail.com
    location: "São Paulo, SP, Brazil"
  background[3]: Quality Engineering,Test Automation,DevOps
  profile_summary:
    roles: "Over 5 years of experience in technology and software quality, working in DevOps, QA engineering, and test automation."
    experience:
      test_automation: "Proficiency in designing, developing, and improving test automation projects for web and desktop applications and APIs, as well as creating and maintaining automated tests using Python, JavaScript, Java, Cypress, Robot Framework, Postman, and Newman. My experience also includes building test frameworks from scratch, maintaining projects with over 400 E2E tests, applying POM and Data-Driven Testing, using tag-based test execution, automating API tests, and integrating tests into CI/CD pipelines."
      quality_assurance: "Experienced in requirements analysis, test planning and design, risk-based prioritization, documenting and executing manual and automated testing strategies, and validating fixes through retesting. I have performed functional, exploratory, regression, integration, and API testing, as well as database validation using SQL."
      devops: "Developed automation and integrations for internal processes using Python and Groovy, consolidated information, generated and distributed reports, and built pipelines with Jenkins and Bitbucket Pipelines. I have also maintained and troubleshot web applications, APIs, databases, and development, staging, and production environments."
    profile: "I bring a strong technical background, critical thinking, and a focus on product quality. I work to understand requirements, business rules, and critical workflows, and to contribute to reliable releases that meet both user expectations and team needs. My approach is collaborative and results-oriented."
    objective: "I am looking for opportunities in software quality where I can apply and expand my skills. I value combining software quality and DevOps practices to broaden coverage, accelerate feedback, and improve release reliability, with a focus on anticipating and preventing problems, supporting decisions, and delivering value."
    long_term_goal: "My goal is to continue growing in technology, with a focus on software quality, by learning new technologies, frameworks, and ways to proactively contribute to product and process quality."
    short: "QA engineer with 5+ years in technology, including 3+ years in QA and automation, and a background in DevOps. I specialize in E2E automation for desktop and web applications and APIs using Python, Robot Framework, and Cypress. I built a framework from scratch that reduced manual regression testing from 6 hours to 1 hour and expanded a Cypress suite to 400+ E2E tests. I bring a technical, collaborative, and results-oriented approach."
  professional_experience_summary:
    experience_years: 5 years and 9 months
    qa_and_test_automation: 3 years and 3 months
    devops: 2 years and 6 months
    senior_qa_automation: 1 year and 5 months
  companies[2]:
    - company: Contmatic Phoenix
      location: "São Paulo, SP, Brazil, Remote"
      total_tenure: 5 years and 9 months
      roles[4]:
        - id: senior-automation
          title: Senior Test Automation Engineer
          period:
            start: 2024-10
            end: 2026-02
          duration: 1 year and 5 months
          duration_months: 17
          area: Quality Engineering / Test Automation / Test Framework Development
          context: Applications developed in Delphi for the tax and accounting sectors.
          domain: Tax and accounting
          achievements[8]{id,text}:
            sr-01,"Designed and built an E2E test automation framework from scratch for desktop applications using Python and Robot Framework, creating reusable components to automate complex regression workflows and reducing regression testing time from approximately 6 hours to 1 hour."
            sr-02,"Integrated desktop test suites with Bitbucket Pipelines and centralized Allure report publishing on HTTP servers, speeding up failure triage and enabling CI/CD automation for desktop regression testing."
            sr-03,"Developed a Python and PowerShell solution to install dependencies and configure Windows servers as desktop test runners. Built it with modular scripts, idempotent, and documented the entire process, reducing manual infrastructure setup effort by approximately 80%. Used AI to help write the scripts."
            sr-04,"Mentored QA professionals in automation best practices, clean code, and programming, helping them get up to speed with the test automation framework."
            sr-05,"Worked with Product and Development to analyze requirements and acceptance criteria, assess risks and context, define test strategies, structure test plans, and write positive and negative test scenarios in Gherkin."
            sr-06,"Performed functional, regression, exploratory, sanity, and integration testing across web and desktop applications and APIs, and used SQL to validate data persistence and consistency."
            sr-07,"Logged defects in Jira, documenting prerequisites, reproduction steps, priority, expected and actual results, evidence, logs, and observed impact."
            sr-08,"Worked with developers to reproduce defects and analyze root causes, clarified issues with product owners, tracked fixes, and retested and validated features before releases."
          tech_stack[18]: Python,PowerShell,Robot Framework,Robocorp,Bitbucket Pipelines,Bitbucket Runner,TestComplete,Windows Server,Nginx,Docker,Allure Report,WinSCP,PostgreSQL,Ansible,Jira,Scrum,BDD,Linux
        - id: devops-pleno
          title: Mid-Level DevOps Engineer
          period:
            start: 2023-09
            end: 2024-10
          duration: 1 year and 1 month
          duration_months: 13
          area: DevOps / CI/CD / Automation
          context: Web applications developed in TypeScript with Angular and REST APIs developed in Java 8 using a microservices architecture. The stack was hosted on CentOS 8 servers.
          domain: Microservices ecosystem and internal products
          achievements[5]{id,text}:
            dv-01,"Developed and maintained Jenkins pipelines integrated into the CI/CD workflow for test execution, deployments, artifact versioning, report generation and publishing, and release validation."
            dv-02,"Developed Python scripts to consolidate information from tools such as Jenkins, SonarQube, and Kibana, automating queries and report distribution for internal monitoring."
            dv-03,"Developed a reusable Jenkins Shared Library with Groovy and Python to send context-rich notifications to Discord directly from pipelines, including build results, commit history, attachments, and structured messages with embeds."
            dv-04,"Supported the maintenance and operation of development, staging, and production environments on virtual machines hosted on Google Cloud Platform (GCP), using SSH and scripts."
            dv-05,"Investigated and resolved issues with pipelines, Java and Angular applications, and internal tools, analyzing logs, services, configuration files, and execution history to restore delivery workflows and unblock operations."
          tech_stack[21]: Python,Java,Groovy,JavaScript,Jenkins,Postman,Newman,Angular,Allure Report,SonarQube,Kibana,Google Cloud Platform,SSH,Red Hat Linux,Nexus Repository,Apache HTTP Server,Tomcat,Maven,SQL,GitLab,Linux
        - id: qa-junior
          title: Junior QA Engineer
          period:
            start: 2021-11
            end: 2023-09
          duration: 1 year and 10 months
          duration_months: 22
          area: Software Quality / Test Automation / Java Backend Feature Development
          context: Testing a web product still under development (Simplifique) and internal REST APIs used to communicate with municipal governments in Brazil.
          domain: Microservices ecosystem and products under development
          achievements[4]{id,text}:
            qa-01,"Progressively took ownership of the architecture and technical leadership of a Cypress/JavaScript automation project that grew from approximately 50 to over 400 E2E tests for a web-based ERP. Applied Page Object Model, Data-Driven Testing, reusable components, selective tag-based execution, self-recovery mechanisms, and multi-environment configurations to improve suite stability and reduce false positives in pipelines."
            qa-02,"Tested business rules and service integrations by creating and running REST API collections in Postman, using request chaining, retries, timeouts, environment variables, scripts, and assertions to validate status codes, messages, response fields, business rules, and integrations between services."
            qa-03,Contributed to the development of new backend features and unit tests using Java and JUnit.
            qa-04,"Participated in Agile ceremonies, refinement sessions, and discussions with product and development teams, analyzing requirements, documenting scenarios, and executing functional and integration tests to validate business rules."
          tech_stack[15]: Cypress,Jenkins,JavaScript,Page Object Model,Data-Driven Testing,Tag-Based Test Execution,Postman,JUnit,Java,Maven,Jira,GitLab,BDD,Linux,Functional Testing
        - id: devops-intern
          title: DevOps Intern
          period:
            start: 2020-06
            end: 2021-11
          duration: 1 year and 5 months
          duration_months: 17
          area: DevOps / Software Engineering
          achievements[3]{id,text}:
            in-01,"Supported DevOps processes, automation, software development, continuous integration, and continuous delivery."
            in-02,"Built a practical foundation in programming, automation, and engineering best practices."
            in-03,Supported technical teams with operational tasks and improvements to development and delivery processes.
          tech_stack[7]: Java,JUnit,Maven,Jenkins,Python,GitLab,SonarQube
